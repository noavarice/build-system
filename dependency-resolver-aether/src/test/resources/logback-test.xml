<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration>

<configuration>
  <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
  <import class="ch.qos.logback.core.ConsoleAppender"/>
  <import class="ch.qos.logback.classic.pattern.color.HighlightingCompositeConverter"/>

  <conversionRule conversionWord="highlight" converterClass="HighlightingCompositeConverter"/>

  <appender name="STDOUT" class="ConsoleAppender">
    <encoder class="PatternLayoutEncoder">
      <pattern>%highlight(%-5level) %X{project:-} %X{ss:-} - %msg%n</pattern>
    </encoder>
  </appender>

  <!--  <logger name="org.eclipse.aether" level="debug"/>-->
  <root level="info">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
